# ──────────────────────────────────────────────────────────────────────────────
# ViagensLabs — variáveis de ambiente
# NÃO subir este arquivo no repositório (.gitignore já garante isso)
# Copie como .env e preencha com os valores reais do seu ambiente.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Banco de Dados (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:SuaSenha@127.0.0.1:5433/solicitacao_viagens?client_encoding=utf8

# ─── Segurança JWT ────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Active Directory (LDAP) ──────────────────────────────────────────────────
AD_SERVER_1=ldap://ML-ASC-AD-01.magazineluiza.intranet
AD_SERVER_2=ldap://ML-ASC-AD2.magazineluiza.intranet
AD_SERVER_3=ldap://ML-HB-AD01.magazineluiza.intranet
AD_DOMAIN=MAGAZINELUIZA
AD_BASE_DN=DC=magazineluiza,DC=intranet

# Grupos AD que determinam o perfil de acesso:
#   G_ACCESS_VIAGENSLABS_ADMINS   → perfil "setor"      → redireciona a /painel.html
#   G_ACCESS_VIAGENSLABS_USERS    → perfil "viajante"   → acesso ao portal principal
#   G_ACCESS_VIAGENSLABS_AGENCIAS → perfil "agencia_ad" → reservado para uso futuro
AD_GROUP_ADMINS=G_ACCESS_VIAGENSLABS_ADMINS
AD_GROUP_USERS=G_ACCESS_VIAGENSLABS_USERS
AD_GROUP_AGENCIAS=G_ACCESS_VIAGENSLABS_AGENCIAS

# ─── E-mail Corporativo (SMTP Relay) ──────────────────────────────────────────
SMTP_HOST=smtpml.magazineluiza.intranet
SMTP_PORT=25
# Remetente dos e-mails enviados pelo sistema
SETOR_EMAIL=vagenslabs@luizalabs.com
# E-mails das agências que receberão solicitações de cotação
AGENCIA_TASTUR_EMAIL=cotacoes@tastur.com.br
AGENCIA_KONTRIP_EMAIL=cotacoes@kontrip.com.br

# ─── Duffel API (Pesquisa de voos reais — opcional) ───────────────────────────
# Obtenha em: https://app.duffel.com → More → Developers → Access Tokens
# Tokens de teste  : duffel_test_...
# Tokens de produção: duffel_live_...
DUFFEL_TOKEN=duffel_test_COLOQUE_SEU_TOKEN_AQUI
